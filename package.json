{
  "name": "nestjs-bullmq-idempotency-lab",
  "version": "1.0.0",
  "description": "Production-shaped NestJS reference for reliable BullMQ processing, transactional outbox delivery, and durable idempotency.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waleedbukhariwork/nestjs-bullmq-idempotency-lab.git"
  },
  "homepage": "https://github.com/waleedbukhariwork/nestjs-bullmq-idempotency-lab#readme",
  "bugs": {
    "url": "https://github.com/waleedbukhariwork/nestjs-bullmq-idempotency-lab/issues"
  },
  "keywords": [
    "nestjs",
    "bullmq",
    "idempotency",
    "transactional-outbox",
    "postgresql",
    "redis"
  ],
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "npm run build:api && npm run build:worker",
    "build:api": "nest build api --builder rspack",
    "build:worker": "nest build worker --builder rspack",
    "start:api": "node dist/apps/api/main.js",
    "start:worker": "node dist/apps/worker/main.js",
    "start:dev:api": "nest start api --watch",
    "start:dev:worker": "nest start worker --watch",
    "db:migrate": "node-pg-migrate up --migrations-dir database/migrations --database-url-var DATABASE_URL",
    "db:migrate:down": "node-pg-migrate down --migrations-dir database/migrations --database-url-var DATABASE_URL",
    "db:seed": "tsx tools/seed.ts",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "lab:all": "tsx tools/run-lab.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config test/jest-unit.json --runInBand",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:integration": "npm run db:migrate && npm run db:seed && npm run test:integration && npm run lab:all"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.4",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.4",
    "@nestjs/platform-express": "12.0.4",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "6.7.0",
    "bullmq": "6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "nestjs-pino": "5.2.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "@prometheus-io/client": "0.16.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.3",
    "@nestjs/schematics": "12.0.4",
    "@nestjs/testing": "12.0.4",
    "@rspack/core": "2.2.6",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "node-pg-migrate": "9.0.0",
    "prettier": "3.9.8",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.15",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "webpack-node-externals": "3.0.0"
  }
}
