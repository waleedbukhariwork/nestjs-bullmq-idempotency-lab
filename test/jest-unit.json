{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/**/*.spec.ts"],
  "testPathIgnorePatterns": ["/node_modules/", "/dist/", "/test/integration/"],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^@lab/config$": "<rootDir>/libs/config/src",
    "^@lab/contracts$": "<rootDir>/libs/contracts/src",
    "^@lab/credits$": "<rootDir>/libs/credits/src",
    "^@lab/database$": "<rootDir>/libs/database/src",
    "^@lab/observability$": "<rootDir>/libs/observability/src",
    "^@lab/queue$": "<rootDir>/libs/queue/src"
  },
  "collectCoverageFrom": [
    "libs/**/*.ts",
    "!libs/**/index.ts",
    "!libs/**/*.module.ts"
  ]
}
